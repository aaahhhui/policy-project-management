DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_API_KEY=
SEED_OWNER_LOGIN=owner
SEED_OWNER_PASSWORD=change-owner-password
SEED_READER_LOGIN=reader
